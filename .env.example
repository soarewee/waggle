# PayPal sandbox app credentials (developer.paypal.com → Apps & Credentials → Sandbox).
# Copy to .env and fill in. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox personal accounts (Testing Tools → Sandbox Accounts) that receive the fee split.
PAYPAL_PUBLISHER_EMAIL=
PAYPAL_USER_EMAIL=
# Optional plugin settings. Installing the plugin is the consent; these narrow it.
# WAGGLE_CATEGORIES=outdoor,electronics   # empty = every category
# WAGGLE_BLOCKED_CATEGORIES=
# WAGGLE_USER_SHARE_BPS=3000              # user's share of each fee (3000 = 30%)
# WAGGLE_RETURN_PORT=8787                 # page PayPal sends the buyer back to
