# Operator settings for running the Waggle service. Users never need any of this: they add one URL to their
# agent. Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox) with Payouts enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox account that receives the publisher's share of each fee.
PAYPAL_PUBLISHER_EMAIL=

# Public origin of this deployment (no trailing slash). PayPal brings buyers back here after checkout; the
# install line on the front page uses it. localhost works in the sandbox.
# WAGGLE_BASE_URL=http://localhost:3000
# PORT=3000
# WAGGLE_DB=data/waggle.db
# WAGGLE_CAMPAIGNS=campaigns.json   # the sellers' campaigns
# WAGGLE_USER_SHARE_BPS=7000        # the user's share of each advertiser fee (7000 = 70%)
